# F-Mate 서버 환경변수 예시. 이 파일을 .env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
# 비워 둔 항목의 기능은 앱에서 "준비 중"으로 표시된다.

# ---- 서버 기본 ----
# 운영에서는 prod (https 주소, JWT_SECRET, FMATE_DEV_MODE=false 필수)
SPRING_PROFILES_ACTIVE=
# 결제창 리다이렉트에 쓰는 이 서버의 외부 주소 (에뮬레이터: http://10.0.2.2:8080)
PUBLIC_BASE_URL=http://10.0.2.2:8080
# Base64 로 인코딩한 32바이트 이상 무작위 값.  생성: openssl rand -base64 48
JWT_SECRET=

# ---- 데이터베이스 ----
DB_URL=jdbc:postgresql://localhost:5432/fmate
DB_USERNAME=fmate
DB_PASSWORD=fmate

# ---- 메일 (가입 인증·비밀번호 재설정 코드) ----
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- 결제: 토스페이먼츠 (테스트 키는 test_ck_ / test_sk_ 로 시작) ----
PAYMENT_MODE=TEST
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---- 사진·영상 스토리지 (S3 호환) ----
# docker compose 로 실행하면 비워 둔 항목은 로컬 SeaweedFS 값으로 채워진다 (docker-compose.yml 참고).
# 운영: AWS S3 는 STORAGE_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com, R2·NCP 는 각 사 엔드포인트
STORAGE_ENDPOINT=
# 앱이 업로드에 쓰는 주소가 서버용 주소와 다를 때만 (로컬: http://10.0.2.2:9000)
STORAGE_PRESIGN_ENDPOINT=
STORAGE_REGION=ap-northeast-2
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_RAW=
STORAGE_BUCKET_PUBLIC=
CDN_BASE_URL=
STORAGE_PATH_STYLE=
# ffmpeg 가 설치된 서버에서 숏폼 인코딩을 켤 때 true (docker compose 기본: true, Docker 이미지에 ffmpeg 포함)
ENCODER_ENABLED=

# ---- 푸시: Firebase 서비스 계정 JSON 파일 경로 ----
FCM_CREDENTIALS_PATH=

# ---- 소셜 로그인 ----
KAKAO_APP_ID=
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=

# ---- 내 주변 실제 풋살장 (카카오 로컬 API) ----
# developers.kakao.com → 내 애플리케이션 → 앱 키 → "REST API 키". 비어 있으면 기능이 꺼진다.
KAKAO_REST_API_KEY=

# ---- 지도: 앱에 지도 키를 넣었으면 true ----
MAPS_ENABLED=false

# ---- 선택 항목: 바꿀 때만 앞의 # 을 지우고 값을 넣는다 ----
# (빈 값으로 두면 기본값이 아니라 '빈 값'으로 읽혀 서버가 시작되지 않을 수 있다)
# 개발 모드: 메일 서버가 없으면 인증 코드를 서버 로그에 출력. 운영 프로필(prod)에서는 자동으로 false
#FMATE_DEV_MODE=
# 웹 관리 도구 등 브라우저에서 API 를 부를 때만 (쉼표 구분)
#CORS_ALLOWED_ORIGINS=
#DB_POOL_SIZE=
#PORT=
# 메일 서버가 인증 없이/STARTTLS 없이 동작할 때 false (기본 true)
#MAIL_SMTP_AUTH=
#MAIL_STARTTLS=
# 메일 서버를 헬스체크에 포함할지 (기본 false)
#MAIL_HEALTH_ENABLED=
# ffmpeg 가 PATH 에 없을 때 경로 지정
#FFMPEG_PATH=
#FFPROBE_PATH=
